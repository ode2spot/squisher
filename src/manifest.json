{
  "manifest_version": 3,
  "name": "Squisher",
  "version": "0.1.0",
  "description": "Compress and EQ audio from the current tab's media, with real metering. Made for old films with quiet dialogue and loud effects.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-bypass": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Toggle Squisher bypass"
    }
  }
}
